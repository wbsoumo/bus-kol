<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1B1C26"
    android:padding="12dp">

    <!-- Top Info Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- Circle Bus Badge Icon -->
        <ImageView
            android:id="@+id/notif_app_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_bus_circle"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- Title: App Name • Route No • now -->
            <TextView
                android:id="@+id/notif_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CholoKolkata • 215A • now"
                android:textColor="#C5C8D6"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <!-- Next Stop Live Distance -->
            <TextView
                android:id="@+id/notif_next_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 km to Debagram"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="2dp" />

            <!-- Speed / Delay Status -->
            <TextView
                android:id="@+id/notif_speed_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed: 26 km/h • Kolkata Traffic Normal"
                android:textColor="#A0A5BA"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Where Is My Train Embedded Card (Drawn dynamically on Canvas with route line & bus pin) -->
    <ImageView
        android:id="@+id/notif_trip_card"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:layout_marginTop="10dp"
        android:scaleType="fitXY" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_set_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set alarm"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:padding="6dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dismiss"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:padding="6dp" />
    </LinearLayout>
</LinearLayout>

