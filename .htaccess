RewriteEngine On
RewriteBase /

# Redirect HTTP -> HTTPS for website pages only (never redirect API, APK downloads, SSL validation, or POST requests so the mobile app is unaffected)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{REQUEST_URI} !^/api(/|$)
RewriteCond %{REQUEST_URI} !^/api\.php
RewriteCond %{REQUEST_URI} !^/download/apk
RewriteCond %{REQUEST_URI} !\.apk$
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Admin panel routing
RewriteRule ^admin/?$ admin/index.php [QSA,L]
RewriteRule ^admin/(.*)$ admin/$1 [QSA,L]

# Direct Android APK download endpoint
RewriteRule ^download/apk/?$ api.php?endpoint=app/download [QSA,L]

# Interactive Web App view & static asset passthrough
RewriteRule ^app/?$ static/app.html [L]
RewriteRule ^assets/(.*)$ static/assets/$1 [L]
RewriteRule ^css/(.*)$ static/css/$1 [L]
RewriteRule ^js/(.*)$ static/js/$1 [L]

# Route all /api/* requests to high-performance native PHP router
RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]

# Normal file serving
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

