# ==============================================================================
# CholoKolkata (চলো কলকাতা) • LiteSpeed / Apache Transit Routing Rules
# ==============================================================================

DirectoryIndex index.php index.html static/index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to deployment script and APK
    RewriteRule ^deploy\.php$ - [L]
    RewriteRule ^import-db$ - [L]
    RewriteRule ^CholoKolkata-release\.apk$ - [L]

    # Route all Transit API calls to api.php
    RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]
    RewriteRule ^api$ api.php [QSA,L]

    # Serve static assets directly from static/ directory
    RewriteCond %{DOCUMENT_ROOT}/static/$1 -f
    RewriteRule ^(.*)$ static/$1 [L]

    # Serve root from static/index.html
    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{DOCUMENT_ROOT}/static/index.html -f
    RewriteRule ^$ static/index.html [L]
</IfModule>
